# .gitattributes - GitHub Linguist configuration
# This file tells GitHub how to categorize files and what to include in language statistics.

# --- Documentation & Metadata ---
*.md linguist-documentation
LICENSE* linguist-documentation
CONTRIBUTING.md linguist-documentation
CHANGELOG.md linguist-documentation
docs/** linguist-documentation
prompts/** linguist-documentation
brain/** linguist-documentation

# --- Assets & Showcase (Vendored) ---
assets/** linguist-vendored
showcase/** linguist-vendored
benches/** linguist-vendored
tests/** -linguist-detectable

# --- Supported Document, Math, Chart & Diagram Formats ---
*.ipynb linguist-vendored
*.tex linguist-vendored
*.latex linguist-vendored
*.typ linguist-vendored
*.typst linguist-vendored
*.html linguist-vendored
*.htm linguist-vendored
*.mdx linguist-vendored
*.qmd linguist-vendored
*.rmd linguist-vendored
*.mmd linguist-vendored
*.mermaid linguist-vendored
*.dot linguist-vendored
*.gv linguist-vendored
*.svg linguist-vendored
*.svgz linguist-vendored
*.csv linguist-vendored
*.tsv linguist-vendored
*.vl linguist-vendored
*.vega linguist-vendored
*.plotly linguist-vendored
*.chem linguist-vendored
*.mhchem linguist-vendored
*.gif linguist-vendored
*.png linguist-vendored
*.jpg linguist-vendored
*.mp4 linguist-vendored
*.mov linguist-vendored
*.webp linguist-vendored
*.zip linguist-vendored
*.tar linguist-vendored
*.tgz linguist-vendored
*.tbz2 linguist-vendored
*.txz linguist-vendored
*.tzst linguist-vendored
*.jar linguist-vendored
*.whl linguist-vendored

# --- Configuration & Workspace Metadata ---
Justfile* -linguist-detectable
*.toml -linguist-detectable
*.lock -linguist-detectable
rust-toolchain.toml -linguist-detectable
config.example.toml linguist-documentation
dist-workspace.toml -linguist-detectable
.github/** -linguist-detectable

# --- Tool-Specific Data ---
.gemini/** -linguist-detectable
.serena/** -linguist-detectable

# --- Scripts & Automation ---
scripts/** linguist-documentation
*.py linguist-vendored
*.lua linguist-vendored
*.sh linguist-documentation

# --- Shell Completions ---
assets/completions/** linguist-documentation

# --- Generated & Backups ---
target/** linguist-generated
**/*.BAK linguist-generated
**/*.bak linguist-generated
