#!/bin/sh

[ "$#" -eq 1 ] && [ -f "$1" ] || exit 0
path=$1
case "$path" in
    -*) path=./$path ;;
esac

case "${FZF_PREVIEW_COLUMNS:-}" in
    ''|*[!0-9]*|0) cols=80 ;;
    *) cols=$FZF_PREVIEW_COLUMNS ;;
esac
case "${FZF_PREVIEW_LINES:-}" in
    ''|*[!0-9]*|0) rows=24 ;;
    *) rows=$FZF_PREVIEW_LINES ;;
esac

case "$path" in
    *.[mM][dD]|*.[mM][aA][rR][kK][dD][oO][wW][nN]|*.[mM][dD][xX]|*.[qQ][mM][dD]|*.[rR][mM][dD])
        if command -v ii >/dev/null 2>&1 &&
            ii --ansi --size "${cols}x${rows}" -- "$path" 2>/dev/null; then
            exit 0
        fi
        ;;
esac

if command -v bat >/dev/null 2>&1; then
    exec bat --color=always --paging=never --style=plain --line-range="1:$rows" -- "$path"
fi
if command -v ii >/dev/null 2>&1; then
    exec ii --size "${cols}x${rows}" -- "$path"
fi
